import java.time.*;
import java.time.format.*;
import java.time.temporal.TemporalAccessor;
import java.util.*;

public final class IsoDateParser {

    private static final List<DateTimeFormatter> FORMATTERS = List.of(
        DateTimeFormatter.ISO_DATE_TIME,     // 2026-11-06T16:37 / ...:00.123 / ...Z / ...+01:00 / ...+01:00[Europe/Paris]
        DateTimeFormatter.ISO_DATE,          // 2026-11-06 / 2026-11-06+01:00
        DateTimeFormatter.ISO_ORDINAL_DATE,  // 2026-310   (day of year)
        DateTimeFormatter.ISO_WEEK_DATE,     // 2026-W45-5 (week date)
        DateTimeFormatter.BASIC_ISO_DATE,    // 20261106   (basic format)
        DateTimeFormatter.ofPattern("uuuuMMdd'T'HHmmss[XX]")  // 20261106T163700Z (basic date-time)
                .withResolverStyle(ResolverStyle.STRICT)
    );

    public static Optional<ZonedDateTime> parse(String text, ZoneId defaultZone) {
        if (text == null || text.isBlank()) return Optional.empty();
        String s = text.trim();
        for (DateTimeFormatter f : FORMATTERS) {
            try {
                TemporalAccessor t = f.parseBest(s,
                        ZonedDateTime::from,    // has a zone or an offset
                        LocalDateTime::from,    // date + time, no offset
                        LocalDate::from);       // date only
                return Optional.of(toZoned(t, defaultZone));
            } catch (DateTimeParseException ignored) { /* next format */ }
        }
        return Optional.empty();
    }

    private static ZonedDateTime toZoned(TemporalAccessor t, ZoneId zone) {
        if (t instanceof ZonedDateTime z)   return z;                  // keeps its own zone/offset
        if (t instanceof LocalDateTime ldt) return ldt.atZone(zone);
        if (t instanceof LocalDate d)       return d.atStartOfDay(zone);
        throw new IllegalArgumentException("Unsupported: " + t.getClass());
    }
}