import java.time.*;
import java.time.format.*;
import java.time.temporal.*;
import java.util.*;

public final class DateConverter {

    public static Optional<String> convert(String text,
                                           List<String> inputPatterns,
                                           String outputPattern,
                                           ZoneId zone) {
        if (text == null || text.isBlank()) return Optional.empty();
        String s = text.trim();
        DateTimeFormatter output = DateTimeFormatter.ofPattern(outputPattern, Locale.ENGLISH);

        for (String pattern : inputPatterns) {
            try {
                TemporalAccessor t = formatter(pattern).parseBest(s,
                        ZonedDateTime::from,   // pattern has a zone or offset
                        LocalDateTime::from,   // date + time
                        LocalDate::from);      // date only
                return Optional.of(output.format(toZoned(t, zone)));
            } catch (DateTimeParseException ignored) { /* try next pattern */ }
        }
        return Optional.empty();
    }

    private static DateTimeFormatter formatter(String pattern) {
        DateTimeFormatterBuilder b = new DateTimeFormatterBuilder()
                .parseCaseInsensitive()
                .appendPattern(pattern);
        if (pattern.contains("y")) b.parseDefaulting(ChronoField.ERA, 1); // lets "yyyy" work in STRICT
        return b.toFormatter(Locale.ENGLISH).withResolverStyle(ResolverStyle.STRICT);
    }

    private static ZonedDateTime toZoned(TemporalAccessor t, ZoneId zone) {
        if (t instanceof ZonedDateTime z)   return z.withZoneSameInstant(zone);
        if (t instanceof LocalDateTime ldt) return ldt.atZone(zone);
        if (t instanceof LocalDate d)       return d.atStartOfDay(zone);
        throw new IllegalArgumentException("Unsupported: " + t.getClass());
    }
}



List<String> inputs = List.of(
        "yyyy-MM-dd'T'HH:mm:ss[.SSS]XXX",  // 2026-11-09T11:29:00Z
        "yyyy-MM-dd HH:mm[:ss]",           // 2026-11-09 11:29
        "dd/MM/yyyy",                      // 09/11/2026
        "yyyyMMdd");                       // 20261109
String out = "dd/MM/yyyy HH:mm:ss";
ZoneId paris = ZoneId.of("Europe/Paris");

convert("2026-11-09T11:29:00Z", inputs, out, paris);  // 09/11/2026 12:29:00
convert("2026-11-09 11:29", inputs, out, paris);      // 09/11/2026 11:29:00
convert("09/11/2026", inputs, out, paris);            // 09/11/2026 00:00:00
convert("31/02/2026", inputs, out, paris);            // Optional.empty (invalid date)