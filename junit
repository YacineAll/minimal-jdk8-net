import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import java.util.function.ToIntFunction;

public final class PathExpander {

    private static final String WILDCARD = "*";
    private static final String SEPARATOR = "/";

    private PathExpander() {}

    /**
     * Expands every "*" in the pattern into @0..@(n-1), where n is given by sizeOf
     * for the concrete path that comes before the "*".
     *
     * @param pattern e.g. "entreprise/filiale/ville/*/magasins/*/commandes"
     * @param sizeOf  given a concrete prefix (e.g. "entreprise/filiale/ville/@0/magasins"),
     *                returns how many elements exist there (0 if none)
     */
    public static List<String> expand(String pattern, ToIntFunction<String> sizeOf) {
        String[] segments = pattern.split(SEPARATOR);
        List<String> result = new ArrayList<>();
        expandRecursive(segments, 0, new ArrayList<>(), sizeOf, result);
        return result;
    }

    private static void expandRecursive(String[] segments, int index, List<String> current,
                                        ToIntFunction<String> sizeOf, List<String> result) {
        if (index == segments.length) {
            result.add(String.join(SEPARATOR, current));
            return;
        }

        String segment = segments[index];

        if (WILDCARD.equals(segment)) {
            String prefix = String.join(SEPARATOR, current);
            int size = sizeOf.applyAsInt(prefix);
            for (int i = 0; i < size; i++) {
                current.add("@" + i);
                expandRecursive(segments, index + 1, current, sizeOf, result);
                current.remove(current.size() - 1);
            }
        } else {
            current.add(segment);
            expandRecursive(segments, index + 1, current, sizeOf, result);
            current.remove(current.size() - 1);
        }
    }

    // ---- Example ----
    public static void main(String[] args) {
        Map<String, Integer> sizes = Map.of(
                "entreprise/filiale/ville", 3,
                "entreprise/filiale/ville/@0/magasins", 3,
                "entreprise/filiale/ville/@1/magasins", 1,
                "entreprise/filiale/ville/@2/magasins", 2
        );

        List<String> paths = expand(
                "entreprise/filiale/ville/*/magasins/*/commandes",
                prefix -> sizes.getOrDefault(prefix, 0));

        paths.forEach(System.out::println);
    }
}

