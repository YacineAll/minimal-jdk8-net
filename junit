import java.util.ArrayList;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public final class PathExpander {

    private PathExpander() {}

    /**
     * Returns the keys of the map that match the pattern exactly.
     * Each "*" matches exactly one segment of the form @<number>.
     */
    public static List<String> expand(String pattern, Map<String, Object> data) {
        Pattern regex = Pattern.compile(toRegex(pattern));
        List<String> result = new ArrayList<>();
        for (String key : data.keySet()) {
            if (regex.matcher(key).matches()) {
                result.add(key);
            }
        }
        return result;
    }

    /**
     * Variant: also works if your keys are deeper than the pattern
     * (e.g. ".../commandes/@0/montant"). Returns the distinct matching prefixes.
     */
    public static List<String> expandPrefixes(String pattern, Map<String, Object> data) {
        Pattern regex = Pattern.compile("(" + toRegex(pattern) + ")(?:/.*)?");
        Set<String> result = new LinkedHashSet<>();
        for (String key : data.keySet()) {
            Matcher m = regex.matcher(key);
            if (m.matches()) {
                result.add(m.group(1));
            }
        }
        return new ArrayList<>(result);
    }

    private static String toRegex(String pattern) {
        String[] segments = pattern.split("/");
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < segments.length; i++) {
            if (i > 0) sb.append("/");
            sb.append("*".equals(segments[i]) ? "@\\d+" : Pattern.quote(segments[i]));
        }
        return sb.toString();
    }

    // ---- Example ----
    public static void main(String[] args) {
        Map<String, Object> data = new java.util.LinkedHashMap<>();
        data.put("entreprise/filiale/ville/@0/magasins/@0/commandes", "...");
        data.put("entreprise/filiale/ville/@0/magasins/@1/commandes", "...");
        data.put("entreprise/filiale/ville/@1/magasins/@0/commandes", "...");
        data.put("entreprise/filiale/ville/@3/magasins/@2/commandes", "...");
        data.put("entreprise/filiale/ville/@0/nom", "Paris");          // ignored
        data.put("entreprise/filiale/ville/@0/magasins/@0/adresse", "x"); // ignored

        expand("entreprise/filiale/ville/*/magasins/*/commandes", data)
                .forEach(System.out::println);
    }
}
