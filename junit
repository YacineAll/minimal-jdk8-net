public final class WildcardPath {

    private static final String WILDCARD = "[*]";

    private WildcardPath() {}

    public static boolean hasWildcard(String path) {
        return path.contains(WILDCARD);
    }

    /** "commandes[*].montant" -> ^commandes\[(\d+)\]\.montant$ */
    public static Pattern toRegex(String path) {
        String[] parts = path.split(Pattern.quote(WILDCARD), -1);
        StringBuilder sb = new StringBuilder("^");
        for (int i = 0; i < parts.length; i++) {
            sb.append(Pattern.quote(parts[i]));
            if (i < parts.length - 1) {
                sb.append("\\[(\\d+)\\]");
            }
        }
        return Pattern.compile(sb.append('$').toString());
    }

    /** Remplace chaque [*] par l'indice correspondant, dans l'ordre. */
    public static String fill(String path, List<String> indices) {
        StringBuilder sb = new StringBuilder();
        int from = 0;
        int i = 0;
        int pos;
        while ((pos = path.indexOf(WILDCARD, from)) >= 0) {
            if (i >= indices.size()) {
                throw new IllegalArgumentException(
                    "La cible '" + path + "' a plus de [*] que la source");
            }
            sb.append(path, from, pos).append('[').append(indices.get(i++)).append(']');
            from = pos + WILDCARD.length();
        }
        return sb.append(path.substring(from)).toString();
    }

    /** Pour chaque clé correspondant au chemin source, renvoie (indices, valeur). */
    public static Map<List<String>, Object> resolve(Map<String, Object> data, String sourcePath) {
        Map<List<String>, Object> result = new LinkedHashMap<>();
        Pattern pattern = toRegex(sourcePath);
        for (Map.Entry<String, Object> entry : data.entrySet()) {
            Matcher m = pattern.matcher(entry.getKey());
            if (m.matches()) {
                List<String> indices = new ArrayList<>();
                for (int g = 1; g <= m.groupCount(); g++) {
                    indices.add(m.group(g));
                }
                result.put(indices, entry.getValue());
            }
        }
        return result;
    }
}


public abstract class AbstractFieldHandler implements HandlerInterface {

    /** cible -> chemin source, construit à partir de la config au moment de la création */
    protected final Map<String, String> mappings;

    protected AbstractFieldHandler(Map<String, String> mappings) {
        this.mappings = mappings;
    }

    /** La transformation propre au handler. */
    protected abstract Object transform(Object sourceValue);

    @Override
    public MessageInterface<Object> apply(DataInputStream config, MessageInterface<Object> message) {
        Map<String, Object> data = message.getData();
        // On collecte d'abord, puis on écrit : évite ConcurrentModificationException
        Map<String, Object> toWrite = new LinkedHashMap<>();

        mappings.forEach((target, source) -> {
            if (!WildcardPath.hasWildcard(source)) {
                if (data.containsKey(source)) {
                    toWrite.put(target, transform(data.get(source)));
                }
                return;
            }
            WildcardPath.resolve(data, source).forEach((indices, value) ->
                toWrite.put(WildcardPath.fill(target, indices), transform(value)));
        });

        data.putAll(toWrite);
        return message;
    }
}


